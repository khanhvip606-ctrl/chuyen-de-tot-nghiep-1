        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;rounded=0;shadow=0;labelBackgroundColor=none;strokeWidth=1;fillColor=none;fontFamily=Verdana;fontSize=12;align=center;verticalAlign=top;spacing=10;comic=1;" value="&lt;div style=&quot;text-align: justify&quot;&gt;&lt;span&gt;Hệ thống tiếp nhận bảo hành và sửa chữa điện thoại di động Mekong Mobile. Quản lý toàn bộ thông tin khách hàng, thiết bị gửi sửa, phân công kỹ thuật viên xử lý và theo dõi sát sao lịch sử trạng thái phiếu sửa chữa một cách minh bạch và nhanh chóng.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify&quot;&gt;&lt;span&gt;Cung cấp công cụ tra cứu tiến độ sửa chữa trực tuyến, cập nhật trạng thái liên tục giúp tối ưu hóa quy trình dịch vụ tại cửa hàng.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
